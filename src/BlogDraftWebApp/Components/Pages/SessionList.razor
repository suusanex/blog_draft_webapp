@page "/workflow/admin"

@using System.Net
@using System.Net.Http.Json
@using BlogDraftWebApp.Api.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>セッション管理</PageTitle>

<h1>セッション管理</h1>

<div class="mb-3">
    <button class="btn btn-primary" disabled="@_isBusy" @onclick="LoadAsync">再読み込み</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error.Message</div>
}

@if (_sessions.Count == 0)
{
    <div class="text-muted">セッションはありません</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>SessionId</th>
                <th>Step</th>
                <th>LastAccessed</th>
                <th>DeleteAt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in _sessions)
            {
                <tr>
                    <td>@session.SessionId</td>
                    <td>@session.CurrentStep</td>
                    <td>@session.LastAccessedAt.LocalDateTime</td>
                    <td>
                        @session.DeleteAt.LocalDateTime
                        @if (IsExpiringSoon(session.DeleteAt))
                        {
                            <div class="text-warning">期限が近づいています（5日以内）</div>
                        }
                    </td>
                    <td>
                        @if (_confirmDeleteSessionId == session.SessionId)
                        {
                            <button class="btn btn-sm btn-danger" disabled="@_isBusy" @onclick="() => DeleteAsync(session.SessionId)">削除を確定</button>
                            <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@_isBusy" @onclick="CancelDelete">キャンセル</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-danger" disabled="@_isBusy" @onclick="() => RequestDelete(session.SessionId)">削除</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<SessionSummaryItem> _sessions = new();
    private ErrorResponse? _error;
    private bool _isBusy;
    private string? _confirmDeleteSessionId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void RequestDelete(string sessionId)
    {
        _confirmDeleteSessionId = sessionId;
    }

    private void CancelDelete()
    {
        _confirmDeleteSessionId = null;
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        _error = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.GetAsync("/workflow/sessions?page=1&pageSize=100");
            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<SessionListResponse>();
                _sessions.Clear();
                _sessions.AddRange(payload?.Sessions ?? new List<SessionSummaryItem>());
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "読み込みに失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(string sessionId)
    {
        _isBusy = true;
        _error = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.DeleteAsync($"/workflow/sessions/{sessionId}");
            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                _sessions.RemoveAll(x => x.SessionId == sessionId);
                _confirmDeleteSessionId = null;
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "削除に失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static bool IsExpiringSoon(DateTimeOffset deleteAt)
        => deleteAt <= DateTimeOffset.UtcNow.AddDays(5);

    private HttpClient CreateHttpClient()
    {
        var http = HttpClientFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }
}
