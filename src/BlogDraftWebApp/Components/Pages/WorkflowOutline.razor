@page "/workflow/outline"
@page "/workflow/outline/{SessionId}"

@using System.Net
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using BlogDraftWebApp.Api.Models
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>ワークフロー生成</PageTitle>

<h1>ワークフロー生成（アウトライン）</h1>

@if (string.IsNullOrWhiteSpace(_sessionId))
{
    <EditForm Model="_model" OnValidSubmit="CreateSessionAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">記事の概要</label>
            <InputTextArea class="form-control" Value="@_model.Overview" ValueChanged="OnOverviewChanged" ValueExpression="(() => _model.Overview)" rows="8" />
            <ValidationMessage For="() => _model.Overview" />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@IsCreateDisabled">セッションを作成</button>
    </EditForm>
}
else
{
    <!-- Progress Stepper -->
    <div class="workflow-progress mb-4">
        <div class="row text-center">
            <div class="col-4">
                <div class="step @("Step1_Outline" == _currentStep ? "active" : (IsStepCompleted("Step1_Outline") ? "completed" : ""))">
                    <div class="step-number">1</div>
                    <div class="step-label">アウトライン</div>
                </div>
            </div>
            <div class="col-4">
                <div class="step @("Step2_Draft" == _currentStep ? "active" : (IsStepCompleted("Step2_Draft") ? "completed" : ""))">
                    <div class="step-number">2</div>
                    <div class="step-label">下書き</div>
                </div>
            </div>
            <div class="col-4">
                <div class="step @("Completed" == _currentStep ? "active" : (IsStepCompleted("Completed") ? "completed" : ""))">
                    <div class="step-number">3</div>
                    <div class="step-label">完了</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div>セッションID: @_sessionId</div>
        <div>現在のステップ: @_currentStep</div>
    </div>

    <!-- Main Action -->
    <div class="mb-4">
        <button class="btn btn-primary btn-lg w-100" disabled="@_isBusy" @onclick="GenerateOutlineAsync">
            @(_isBusy ? "生成中..." : (string.IsNullOrWhiteSpace(_outlineContent) ? "アウトラインを生成" : "再生成"))
        </button>
    </div>

    @if (_refreshDiff is not null)
    {
        <div class="alert alert-info">
            <div>RAG差分: +@_refreshDiff.AddedChunkCount / -@_refreshDiff.RemovedChunkCount (rate=@_refreshDiff.ChangeRate)</div>
            <button class="btn btn-sm btn-primary mt-2" disabled="@_isBusy" @onclick="ConfirmRagRefreshAsync">この差分を採用</button>
        </div>
    }

    <!-- Edit Area -->
    <div class="mb-4">
        <label class="form-label">アウトライン</label>
        <InputTextArea class="form-control" Value="@_outlineContent" ValueChanged="OnOutlineChanged" ValueExpression="(() => _outlineContent)" rows="12" />
        @if (!string.IsNullOrWhiteSpace(_autoSaveMessage))
        {
            <small class="text-muted">@_autoSaveMessage</small>
        }
    </div>

    <!-- Confirm and Next -->
    @if (_currentStep is "Step1_Outline")
    {
        <div class="mb-4">
            <button class="btn btn-success btn-lg w-100" disabled="@_isBusy || string.IsNullOrWhiteSpace(_outlineContent)" @onclick="ConfirmOutlineAsync">
                確定して次へ進む → Step2: 下書き生成
            </button>
        </div>
    }
    else if (_currentStep is "Step2_Draft" or "Completed")
    {
        <div class="mb-4">
            <div class="alert alert-info">アウトラインは確定済みです。下書きステップへ進んでください。</div>
            <button class="btn btn-outline-primary btn-lg w-100" disabled="@_isBusy" @onclick="NavigateToDraft">
                下書きへ進む
            </button>
        </div>
    }

    <!-- Auxiliary Actions (Collapsible) -->
    <details class="mb-3">
        <summary class="btn btn-link">▼ 詳細オプション</summary>
        <div class="mt-3 d-flex flex-column gap-2">
            <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="PreviewOutlineAsync">プロンプトを確認</button>
            <button class="btn btn-outline-warning" disabled="@_isBusy" @onclick="RefreshRagAsync">RAG再検索</button>
            <button class="btn btn-outline-secondary" disabled="@_isBusy || string.IsNullOrWhiteSpace(_outlineContent)" @onclick="() => SaveOutlineAsync()">手動保存</button>
        </div>
    </details>
}

<!-- Preview Modal -->
@if (_showPreviewModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">LLM 入力内容（プレビュー）</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreviewModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">⚠️ この内容は機微情報を含みます。共有しないでください。</div>
                    <pre style="white-space: pre-wrap;">@_promptPreview</pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreviewModal">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_warning))
{
    <div class="alert alert-warning mt-3">@_warning</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">
        <div>@_error.Message</div>
        @if (_error.IsRetryable)
        {
            <button class="btn btn-outline-danger mt-2" @onclick="RetryAsync">再試行</button>
        }
    </div>
}

@code {
    [Parameter]
    public string? SessionId { get; set; }

    private sealed class WorkflowOutlineViewModel
    {
        [Required(ErrorMessage = "記事の概要を入力してください")]
        [MinLength(10, ErrorMessage = "概要は 10 文字以上入力してください")]
        [MaxLength(5000, ErrorMessage = "概要は 5000 文字以内で入力してください")]
        public string Overview { get; set; } = string.Empty;
    }

    private WorkflowOutlineViewModel _model = new();
    private string? _sessionId;
    private string _currentStep = "Step1_Outline";
    private string _outlineContent = string.Empty;
    private string? _warning;
    private string? _promptPreview;
    private RefreshRagSnapshotResponse? _refreshDiff;
    private ErrorResponse? _error;
    private bool _isBusy;
    private string? _autoSaveMessage;
    private CancellationTokenSource? _autoSaveCts;
    private bool _showPreviewModal;

    private bool IsCreateDisabled => _isBusy || string.IsNullOrWhiteSpace(_model.Overview);

    private bool IsStepCompleted(string checkStep)
    {
        return checkStep switch
        {
            "Step1_Outline" => !string.IsNullOrWhiteSpace(_outlineContent) && (_currentStep is "Step2_Draft" or "Completed"),
            "Step2_Draft" => _currentStep is "Completed",
            "Completed" => _currentStep is "Completed",
            _ => false
        };
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
        _promptPreview = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(SessionId) && SessionId != _sessionId)
        {
            _sessionId = SessionId;
            await LoadSessionAsync();
        }
    }

    private void OnOverviewChanged(string value)
    {
        _model.Overview = value;
        StateHasChanged();
    }

    private void OnOutlineChanged(string value)
    {
        _outlineContent = value;
        ScheduleAutoSave();
    }

    private async Task CreateSessionAsync()
    {
        _isBusy = true;
        _error = null;
        _warning = null;
        _promptPreview = null;
        _refreshDiff = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync("/workflow/sessions", new CreateSessionRequest
            {
                Overview = _model.Overview,
            });

            if (response.StatusCode == HttpStatusCode.Created)
            {
                var payload = await response.Content.ReadFromJsonAsync<CreateSessionResponse>();
                if (payload is not null)
                {
                    _sessionId = payload.SessionId;
                    _currentStep = payload.CurrentStep;
                    Nav.NavigateTo($"/workflow/outline/{payload.SessionId}");
                    return;
                }
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse
            {
                ErrorCode = "UNKNOWN",
                Message = "エラーが発生しました",
                IsRetryable = false,
            };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _warning = null;
        _promptPreview = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.GetAsync($"/workflow/sessions/{_sessionId}");
            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<GetSessionResponse>();
                if (payload is not null)
                {
                    _currentStep = payload.CurrentStep;
                    _model.Overview = payload.InitialInput;
                    _outlineContent = payload.OutlineConfirmed
                        ?? payload.OutlineEdited
                        ?? payload.OutlineGenerated
                        ?? string.Empty;
                    return;
                }
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            if (_error?.ErrorCode == "SESSION_EXPIRED")
            {
                _error.Message = "セッションの有効期限が切れています";
            }

            _error ??= new ErrorResponse
            {
                ErrorCode = "UNKNOWN",
                Message = "エラーが発生しました",
                IsRetryable = false,
            };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task GenerateOutlineAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _warning = null;
        _promptPreview = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync($"/workflow/sessions/{_sessionId}/steps/outline/generate", new GenerateStepRequest
            {
                Regenerate = false,
            });

            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<GenerateStepResponse>();
                if (payload is not null)
                {
                    _outlineContent = payload.Generated;
                    _warning = payload.Warning;
                    _promptPreview = null;
                    return;
                }
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse
            {
                ErrorCode = "UNKNOWN",
                Message = "エラーが発生しました",
                IsRetryable = false,
            };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task PreviewOutlineAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _warning = null;
        _promptPreview = null;
        _showPreviewModal = false;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsync($"/workflow/sessions/{_sessionId}/steps/outline/preview", content: null);
            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<PreviewPromptResponse>();
                _promptPreview = payload?.Prompt;
                _warning = payload?.Warning;
                _showPreviewModal = true;
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse
            {
                ErrorCode = "UNKNOWN",
                Message = "エラーが発生しました",
                IsRetryable = false,
            };
        }
        finally
        {
            _isBusy = false;
        }
    }

        private async Task SaveOutlineAsync(bool userInitiated = true)
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        if (userInitiated)
        {
            _isBusy = true;
            _error = null;
            _autoSaveMessage = null;
        }

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync($"/workflow/sessions/{_sessionId}/steps/outline/save", new SaveStepRequest
            {
                EditedContent = _outlineContent,
            });

            if (response.StatusCode == HttpStatusCode.OK)
            {
                _autoSaveMessage = userInitiated ? "保存しました" : "自動保存しました";
                return;
            }

            var apiError = await response.Content.ReadFromJsonAsync<ErrorResponse>()
                ?? new ErrorResponse
                {
                    ErrorCode = "UNKNOWN",
                    Message = "保存に失敗しました",
                    IsRetryable = false,
                };

            if (userInitiated)
            {
                _error = apiError;
            }
            else
            {
                _autoSaveMessage = "自動保存に失敗しました";
            }
        }
        finally
        {
            if (userInitiated)
            {
                _isBusy = false;
            }
        }
    }
    private async Task ConfirmOutlineAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync($"/workflow/sessions/{_sessionId}/steps/outline/confirm", new ConfirmStepRequest
            {
                ConfirmedContent = _outlineContent,
            });

            if (response.StatusCode == HttpStatusCode.OK)
            {
                _currentStep = "Step2_Draft";
                _promptPreview = null;
                _showPreviewModal = false;
                Nav.NavigateTo($"/workflow/draft/{_sessionId}");
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse
            {
                ErrorCode = "UNKNOWN",
                Message = "エラーが発生しました",
                IsRetryable = false,
            };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RefreshRagAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsync($"/workflow/sessions/{_sessionId}/rag/refresh", content: null);
            if (response.StatusCode == HttpStatusCode.OK)
            {
                _refreshDiff = await response.Content.ReadFromJsonAsync<RefreshRagSnapshotResponse>();
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "RAG再検索に失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmRagRefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _isBusy = true;
        _error = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsync($"/workflow/sessions/{_sessionId}/rag/refresh/confirm", content: null);
            if (response.StatusCode == HttpStatusCode.OK)
            {
                _refreshDiff = null;
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "RAG再検索確定に失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void NavigateToDraft()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        Nav.NavigateTo($"/workflow/draft/{_sessionId}");
    }

    private Task RetryAsync() => GenerateOutlineAsync();

    private void ScheduleAutoSave()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return;
        }

        _autoSaveCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autoSaveCts = cts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(800), cts.Token);
                if (!cts.Token.IsCancellationRequested)
                {
                    await InvokeAsync(() => SaveOutlineAsync(userInitiated: false));
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private HttpClient CreateHttpClient()
    {
        var http = HttpClientFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }
}


