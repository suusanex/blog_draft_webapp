@page "/title-hook"

@using System.Net
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using BlogDraftWebApp.Api.Models
@using BlogDraftWebApp.Core.Models
@using BlogDraftWebApp.Services
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject ClipboardService ClipboardService

<PageTitle>タイトル・導入文案生成</PageTitle>

<h1>タイトル・冒頭段落案生成</h1>
<p class="text-muted">完成した本文を入力して、タイトルと冒頭段落の案を作成します（ワークフローとは独立した機能です）。</p>

<EditForm Model="_model" OnValidSubmit="GenerateTitleHookAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">本文</label>
        <InputTextArea class="form-control" Value="@_model.ArticleBody" ValueChanged="OnArticleBodyChanged" ValueExpression="(() => _model.ArticleBody)" rows="14" />
        <ValidationMessage For="() => _model.ArticleBody" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit" disabled="@IsGenerateDisabled">@(_isBusy ? "生成中..." : "案を生成")</button>
        <button class="btn btn-outline-secondary" type="button" disabled="@IsGenerateDisabled" @onclick="PreviewTitleHookAsync">プロンプトを確認</button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_warning))
{
    <div class="alert alert-warning mt-3">@_warning</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">
        <div>@_error.Message</div>
        @if (_error.IsRetryable)
        {
            <button class="btn btn-outline-danger mt-2" @onclick="GenerateTitleHookAsync">再試行</button>
        }
    </div>
}

@if (_options.Count > 0)
{
    <h2 class="h5 mt-4">生成結果（3案）</h2>
    <div class="row g-2 mb-3">
        @foreach (var option in _options)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="titleOption" checked="@(option.OptionIndex == _selectedOptionIndex)" @onchange="() => SelectOption(option)" />
                            <label class="form-check-label">案 @option.OptionIndex</label>
                        </div>
                        <div class="fw-bold mt-2">@option.Title</div>
                        <div class="small text-muted mt-2">@option.HookText</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">タイトル（編集）</label>
        <InputText class="form-control" Value="@_title" ValueChanged="OnTitleChanged" ValueExpression="(() => _title)" />
    </div>

    <div class="mb-3">
        <label class="form-label">冒頭段落（編集）</label>
        <InputTextArea class="form-control" Value="@_hookText" ValueChanged="OnHookChanged" ValueExpression="(() => _hookText)" rows="8" />
    </div>

    <button class="btn btn-outline-secondary" disabled="@_isBusy || string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_hookText)" @onclick="CopyFinalAsync">コピー</button>
    @if (!string.IsNullOrWhiteSpace(_copyMessage))
    {
        <div class="text-success mt-2">@_copyMessage</div>
    }
}

@if (_showPreviewModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">LLM 入力内容（プレビュー）</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreviewModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">⚠️ この内容は機微情報を含みます。共有しないでください。</div>
                    <pre style="white-space: pre-wrap;">@_promptPreview</pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreviewModal">閉じる</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private sealed class TitleHookViewModel
    {
        [Required(ErrorMessage = "本文を入力してください")]
        [MinLength(100, ErrorMessage = "本文は 100 文字以上入力してください")]
        [MaxLength(50000, ErrorMessage = "本文は 50000 文字以内で入力してください")]
        public string ArticleBody { get; set; } = string.Empty;
    }

    private TitleHookViewModel _model = new();
    private List<TitleHook> _options = new();
    private int? _selectedOptionIndex;
    private string _title = string.Empty;
    private string _hookText = string.Empty;
    private string? _warning;
    private string? _copyMessage;
    private string? _promptPreview;
    private ErrorResponse? _error;
    private bool _isBusy;
    private bool _showPreviewModal;

    private bool IsGenerateDisabled => _isBusy || string.IsNullOrWhiteSpace(_model.ArticleBody);

    private void OnArticleBodyChanged(string value)
    {
        _model.ArticleBody = value;
    }

    private void OnTitleChanged(string value)
    {
        _title = value;
    }

    private void OnHookChanged(string value)
    {
        _hookText = value;
    }

    private void SelectOption(TitleHook option)
    {
        _selectedOptionIndex = option.OptionIndex;
        _title = option.Title;
        _hookText = option.HookText;
    }

    private async Task GenerateTitleHookAsync()
    {
        _isBusy = true;
        _error = null;
        _warning = null;
        _copyMessage = null;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync("/titlehook", new GenerateTitleHookRequest
            {
                ArticleBody = _model.ArticleBody,
            });

            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<GenerateTitleHookResponse>();
                _options = payload?.Options ?? new List<TitleHook>();
                _warning = payload?.Warning;

                var first = _options.FirstOrDefault();
                if (first is not null)
                {
                    _selectedOptionIndex = first.OptionIndex;
                    _title = first.Title;
                    _hookText = first.HookText;
                }

                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "タイトル案生成に失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task PreviewTitleHookAsync()
    {
        _isBusy = true;
        _error = null;
        _warning = null;
        _promptPreview = null;
        _showPreviewModal = false;

        try
        {
            var http = CreateHttpClient();
            var response = await http.PostAsJsonAsync("/titlehook/preview", new GenerateTitleHookRequest
            {
                ArticleBody = _model.ArticleBody,
            });

            if (response.StatusCode == HttpStatusCode.OK)
            {
                var payload = await response.Content.ReadFromJsonAsync<PreviewPromptResponse>();
                _promptPreview = payload?.Prompt;
                _showPreviewModal = true;
                return;
            }

            _error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            _error ??= new ErrorResponse { Message = "プレビュー取得に失敗しました", IsRetryable = false };
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
        _promptPreview = null;
    }

    private async Task CopyFinalAsync()
    {
        await ClipboardService.CopyTextAsync($"{_title}\n\n{_hookText}");
        _copyMessage = "コピーしました";
    }

    private HttpClient CreateHttpClient()
    {
        var http = HttpClientFactory.CreateClient();
        http.BaseAddress = new Uri(Nav.BaseUri);
        return http;
    }
}



